// Prisma Schema for CRM Application
// Multi-tenant architecture - each user sees only their data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// User Model - المستخدمين
// =============================================
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  company   String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - العلاقات
  customers      Customer[]      // العملاء التابعين للمستخدم
  deals          Deal[]          // الصفقات التابعة للمستخدم
  tasksAssigned  Task[]          @relation("AssignedTasks") // المهام المسندة للمستخدم
  tasksCreated   Task[]          @relation("CreatedTasks")  // المهام التي أنشأها المستخدم
  notifications  Notification[]  // الإشعارات
  emailTemplates EmailTemplate[] // قوالب البريد
  emailLogs      EmailLog[]      // سجل البريد
  documents      Document[]      // المستندات
  activities     Activity[]      // سجل النشاط
  notes          Note[]          // الملاحظات
  meetings       Meeting[]       // الاجتماعات

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// =============================================
// Customer Model - العملاء
// =============================================
model Customer {
  id        String         @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  address   String?
  status    CustomerStatus @default(LEAD)
  tags      String[]       @default([])
  notesText String?        @map("notes")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Multi-tenant: كل عميل تابع لمستخدم واحد
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  deals     Deal[]
  tasks     Task[]
  emailLogs EmailLog[]
  documents Document[]
  notes     Note[]
  meetings  Meeting[]

  @@index([ownerId])
  @@index([email])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
}

// =============================================
// Deal Model - الصفقات
// =============================================
model Deal {
  id                String    @id @default(cuid())
  title             String
  description       String?
  value             Float     @default(0)
  stage             DealStage @default(LEAD)
  probability       Int       @default(10) // 0-100
  expectedCloseDate DateTime?
  closedDate        DateTime?
  notesText         String?   @map("notes")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Multi-tenant: كل صفقة تابعة لمستخدم واحد
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relation to Customer
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Relations
  tasks     Task[]
  emailLogs EmailLog[]
  documents Document[]
  notes     Note[]
  meetings  Meeting[]

  @@index([ownerId])
  @@index([customerId])
  @@index([stage])
  @@map("deals")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// =============================================
// Task Model - المهام
// =============================================
model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  type          TaskType     @default(OTHER)
  priority      Priority     @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  dueDate       DateTime?
  completedDate DateTime?
  notesText     String?      @map("notes")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Multi-tenant: المهام المسندة للمستخدم
  assignedToId String
  assignedTo   User   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)

  // من أنشأ المهمة
  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  // Optional relations
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // Notes relation
  notes Note[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// =============================================
// Notification Model - الإشعارات
// =============================================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

enum NotificationType {
  TASK_DUE
  TASK_ASSIGNED
  DEAL_WON
  DEAL_LOST
  DEAL_STAGE_CHANGED
  NEW_CUSTOMER
  REMINDER
  SYSTEM
}

// =============================================
// Email Template Model - قوالب البريد
// =============================================
model EmailTemplate {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("email_templates")
}

// =============================================
// Email Log Model - سجل البريد المرسل
// =============================================
model EmailLog {
  id         String      @id @default(cuid())
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  body       String
  status     EmailStatus @default(SENT)
  sentAt     DateTime    @default(now())

  @@index([ownerId])
  @@index([customerId])
  @@map("email_logs")
}

enum EmailStatus {
  SENT
  FAILED
  BOUNCED
}

// =============================================
// Document Model - المستندات والملفات
// =============================================
model Document {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  name       String
  type       String
  size       Int
  url        String
  createdAt  DateTime  @default(now())

  @@index([ownerId])
  @@index([customerId])
  @@index([dealId])
  @@map("documents")
}

// =============================================
// Activity Model - سجل النشاط
// =============================================
model Activity {
  id         String       @id @default(cuid())
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type       ActivityType
  entityType String
  entityId   String
  title      String
  details    Json?
  createdAt  DateTime     @default(now())

  @@index([ownerId])
  @@index([entityType, entityId])
  @@map("activities")
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  STAGE_CHANGED
  EMAIL_SENT
  NOTE_ADDED
  FILE_UPLOADED
  TASK_COMPLETED
}

// =============================================
// Note Model - الملاحظات
// =============================================
model Note {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content    String
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId])
  @@index([customerId])
  @@index([dealId])
  @@map("notes")
}

// =============================================
// Meeting Model - الاجتماعات
// =============================================
model Meeting {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  reminder    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([startTime])
  @@map("meetings")
}

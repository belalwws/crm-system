// Prisma Schema for CRM Application v2.0
// Enterprise-grade CRM with AI, Workflows, Audit Logs, Soft Delete
// Multi-tenant architecture - each user sees only their data

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// User Model - المستخدمين
// =============================================
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  company   String?
  role      Role     @default(USER)
  avatar    String?
  phone     String?
  timezone  String?  @default("UTC")
  isActive  Boolean  @default(true)
  emailVerified   Boolean  @default(false)
  verifyToken     String?
  verifyTokenExp  DateTime?
  resetToken      String?
  resetTokenExp   DateTime?
  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers          Customer[]
  deals              Deal[]
  tasksAssigned      Task[]           @relation("AssignedTasks")
  tasksCreated       Task[]           @relation("CreatedTasks")
  notifications      Notification[]
  emailTemplates     EmailTemplate[]
  emailLogs          EmailLog[]
  documents          Document[]
  activities         Activity[]
  notes              Note[]
  meetings           Meeting[]
  savedViews         SavedView[]
  auditLogs          AuditLog[]       @relation("AuditUser")
  workflowsCreated   WorkflowRule[]
  webhooks           Webhook[]
  assignmentRules    AssignmentRule[]
  contacts           Contact[]
  products           Product[]
  quotes             Quote[]
  teamMemberships    TeamMember[]
  customFields       CustomField[]
  chatSessions       ChatSession[]
  subscription       Subscription?
  pushTokens         PushToken[]
  refreshTokens      RefreshToken[]

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

// =============================================
// Customer Model - العملاء
// =============================================
model Customer {
  id          String         @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  address     String?
  status      CustomerStatus @default(LEAD)
  source      LeadSource?
  industry    String?
  website     String?
  tags        String[]       @default([])
  notesText   String?        @map("notes")
  // Soft Delete
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Multi-tenant
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  deals           Deal[]
  tasks           Task[]
  emailLogs       EmailLog[]
  documents       Document[]
  notes           Note[]
  meetings        Meeting[]
  timelineEvents  TimelineEvent[]
  contacts        Contact[]
  quotes          Quote[]

  @@index([ownerId])
  @@index([email])
  @@index([phone])
  @@index([name])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([ownerId, deletedAt])
  @@index([ownerId, status])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_CALL
  EMAIL_CAMPAIGN
  TRADE_SHOW
  PARTNER
  OTHER
}

// =============================================
// Deal Model - الصفقات
// =============================================
model Deal {
  id                String    @id @default(cuid())
  title             String
  description       String?
  value             Decimal   @default(0) @db.Decimal(15, 2)
  stage             DealStage @default(LEAD)
  probability       Int       @default(10)
  expectedCloseDate DateTime?
  closedDate        DateTime?
  lostReason        String?
  notesText         String?   @map("notes")
  // Soft Delete
  deletedAt         DateTime?
  deletedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Multi-tenant
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Relations
  tasks           Task[]
  emailLogs       EmailLog[]
  documents       Document[]
  notes           Note[]
  meetings        Meeting[]
  timelineEvents  TimelineEvent[]
  quotes          Quote[]

  @@index([ownerId])
  @@index([customerId])
  @@index([stage])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([expectedCloseDate])
  @@index([ownerId, deletedAt])
  @@index([ownerId, stage])
  @@map("deals")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// =============================================
// Task Model - المهام
// =============================================
model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  type          TaskType   @default(OTHER)
  priority      Priority   @default(MEDIUM)
  status        TaskStatus @default(PENDING)
  dueDate       DateTime?
  completedDate DateTime?
  notesText     String?    @map("notes")
  // Soft Delete
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Multi-tenant
  assignedToId String
  assignedTo   User   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  // Optional relations
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // Notes relation
  notes Note[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([assignedToId, deletedAt])
  @@index([assignedToId, status])
  @@map("tasks")
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  WHATSAPP
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// =============================================
// Notification Model - الإشعارات
// =============================================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  TASK_DUE
  TASK_ASSIGNED
  TASK_OVERDUE
  DEAL_WON
  DEAL_LOST
  DEAL_STAGE_CHANGED
  NEW_CUSTOMER
  DUPLICATE_DETECTED
  WORKFLOW_TRIGGERED
  REMINDER
  SYSTEM
}

// =============================================
// Email Template Model - قوالب البريد
// =============================================
model EmailTemplate {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String
  category  String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@map("email_templates")
}

// =============================================
// Email Log Model - سجل البريد المرسل
// =============================================
model EmailLog {
  id         String      @id @default(cuid())
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  body       String
  status     EmailStatus @default(SENT)
  openedAt   DateTime?
  repliedAt  DateTime?
  sentAt     DateTime    @default(now())

  @@index([ownerId])
  @@index([customerId])
  @@index([dealId])
  @@map("email_logs")
}

enum EmailStatus {
  SENT
  FAILED
  BOUNCED
  OPENED
  REPLIED
}

// =============================================
// Document Model - المستندات والملفات
// =============================================
model Document {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  name       String
  type       String
  size       Int
  url        String
  category   String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
  @@index([customerId])
  @@index([dealId])
  @@map("documents")
}

// =============================================
// Activity Model - سجل النشاط
// =============================================
model Activity {
  id         String       @id @default(cuid())
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type       ActivityType
  entityType String
  entityId   String
  title      String
  details    Json?
  createdAt  DateTime     @default(now())

  @@index([ownerId])
  @@index([entityType, entityId])
  @@index([ownerId, createdAt])
  @@map("activities")
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  RESTORED
  STATUS_CHANGED
  STAGE_CHANGED
  EMAIL_SENT
  NOTE_ADDED
  FILE_UPLOADED
  TASK_COMPLETED
  MERGED
  WORKFLOW_TRIGGERED
}

// =============================================
// Note Model - الملاحظات
// =============================================
model Note {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content    String
  pinned     Boolean   @default(false)
  mentions   String[]  @default([])
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId])
  @@index([customerId])
  @@index([dealId])
  @@index([taskId])
  @@map("notes")
}

// =============================================
// Meeting Model - الاجتماعات
// =============================================
model Meeting {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  reminder    Int?
  outcome     String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([startTime])
  @@map("meetings")
}

// =============================================
// Timeline Event Model - الأحداث الزمنية الموحدة
// =============================================
model TimelineEvent {
  id          String            @id @default(cuid())
  ownerId     String
  type        TimelineEventType
  title       String
  description String?
  metadata    Json?
  // Polymorphic relations
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([customerId])
  @@index([dealId])
  @@index([ownerId])
  @@index([type])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([dealId, createdAt])
  @@map("timeline_events")
}

enum TimelineEventType {
  NOTE
  CALL
  EMAIL_SENT
  EMAIL_RECEIVED
  MEETING
  WHATSAPP
  STAGE_CHANGED
  STATUS_CHANGED
  TASK_CREATED
  TASK_COMPLETED
  FILE_UPLOADED
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
  MENTION
  SYSTEM
}

// =============================================
// Saved View Model - العروض المحفوظة
// =============================================
model SavedView {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  entity     String   // 'customers' | 'deals' | 'tasks'
  filters    Json     // { status: 'LEAD', tags: ['hot'], dateRange: {...} }
  sorting    Json?    // { field: 'createdAt', order: 'desc' }
  columns    Json?    // which columns to show
  isDefault  Boolean  @default(false)
  color      String?
  icon       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
  @@index([entity])
  @@map("saved_views")
}

// =============================================
// Audit Log Model - سجل التدقيق
// =============================================
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("AuditUser", fields: [userId], references: [id], onDelete: Cascade)
  action     String   // CREATE, UPDATE, DELETE, RESTORE, MERGE, STAGE_CHANGE
  entityType String   // 'Customer', 'Deal', 'Task', etc.
  entityId   String
  entityName String?  // human-readable name at time of action
  oldValues  Json?    // previous values (for updates)
  newValues  Json?    // new values (for updates)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================
// Workflow Rule Model - قواعد الأتمتة
// =============================================
model WorkflowRule {
  id              String          @id @default(cuid())
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  trigger         WorkflowTrigger
  conditions      Json            // { field: 'stage', operator: 'equals', value: 'PROPOSAL' }
  actions         Json            // [{ type: 'CREATE_TASK', params: {...} }]
  isActive        Boolean         @default(true)
  executionCount  Int             @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  logs WorkflowLog[]

  @@index([ownerId])
  @@index([trigger])
  @@index([isActive])
  @@map("workflow_rules")
}

enum WorkflowTrigger {
  DEAL_STAGE_CHANGED
  DEAL_CREATED
  DEAL_UPDATED
  TASK_OVERDUE
  CUSTOMER_STATUS_CHANGED
  CUSTOMER_CREATED
}

model WorkflowLog {
  id         String       @id @default(cuid())
  ruleId     String
  rule       WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  status     String       // 'SUCCESS' | 'FAILED'
  details    Json?
  createdAt  DateTime     @default(now())

  @@index([ruleId])
  @@index([createdAt])
  @@map("workflow_logs")
}

// =============================================
// Assignment Rule Model - قواعد التوزيع التلقائي
// =============================================
model AssignmentRule {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  conditions        Json     // { source: 'FACEBOOK', region: 'EMEA' }
  assignToIds       String[] // user IDs to round-robin between
  method            String   @default("round_robin") // 'round_robin' | 'load_balanced'
  lastAssignedIndex Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerId])
  @@index([isActive])
  @@map("assignment_rules")
}

// =============================================
// Webhook Model - الويب هوك
// =============================================
model Webhook {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  url             String
  events          String[]  // ['deal.created', 'deal.won', 'customer.created']
  secret          String?   // for HMAC verification
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  logs WebhookLog[]

  @@index([ownerId])
  @@index([isActive])
  @@map("webhooks")
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  payload    Json
  statusCode Int?
  response   String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_logs")
}

// =============================================
// System Settings - إعدادات النظام
// =============================================
model SystemSettings {
  id               String   @id @default(cuid())
  companyName      String   @default("My CRM")
  defaultCurrency  String   @default("USD")
  defaultTimezone  String   @default("UTC")
  maxUsersAllowed  Int      @default(50)
  features         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("system_settings")
}

// =============================================
// User Preferences - تفضيلات المستخدم
// =============================================
model UserPreferences {
  id                   String  @id @default(cuid())
  userId               String  @unique
  // Notification preferences
  emailTaskReminders   Boolean @default(true)
  emailDealUpdates     Boolean @default(true)
  emailWeeklyDigest    Boolean @default(false)
  pushTaskReminders    Boolean @default(true)
  pushDealWon          Boolean @default(true)
  pushNewCustomer      Boolean @default(false)
  // Email settings
  emailSignature       String  @default("")
  defaultCc            String  @default("")
  replyTo              String  @default("")
  // Display
  displayDensity       String  @default("comfortable") // 'comfortable' | 'compact'
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_preferences")
}

// =============================================
// Contact Model - جهات الاتصال
// Separate from Customer - a Customer (company) can have multiple Contacts
// =============================================
model Contact {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?  // Job title
  department String?
  isPrimary  Boolean   @default(false)
  linkedIn   String?
  notes      String?
  // Soft Delete
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([ownerId])
  @@index([email])
  @@index([deletedAt])
  @@index([ownerId, deletedAt])
  @@map("contacts")
}

// =============================================
// Product Model - المنتجات
// =============================================
model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String?
  description String?
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("USD")
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  lineItems LineItem[]

  @@unique([ownerId, sku])
  @@index([ownerId])
  @@index([sku])
  @@map("products")
}

// =============================================
// Quote Model - عروض الأسعار
// =============================================
model Quote {
  id             String      @id @default(cuid())
  quoteNumber    String      @unique
  title          String
  status         QuoteStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  discountType   String      @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  tax            Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  validUntil     DateTime?
  notes          String?
  terms          String?
  sentAt         DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lineItems  LineItem[]

  @@index([ownerId])
  @@index([customerId])
  @@index([dealId])
  @@index([status])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// =============================================
// Line Item Model - بنود الفاتورة
// =============================================
model LineItem {
  id          String   @id @default(cuid())
  description String?
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("line_items")
}

// =============================================
// Team Model - الفرق
// =============================================
model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String         @id @default(cuid())
  role      TeamRole       @default(MEMBER)
  joinedAt  DateTime       @default(now())

  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

// =============================================
// Custom Field - الحقول المخصصة
// =============================================
model CustomField {
  id          String          @id @default(cuid())
  name        String
  label       String
  fieldType   CustomFieldType
  entity      String          // 'customer', 'deal', 'task', 'contact'
  isRequired  Boolean         @default(false)
  options     Json?           // For SELECT/MULTI_SELECT types
  defaultValue String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  values      CustomFieldValue[]

  @@index([ownerId, entity])
  @@map("custom_fields")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

model CustomFieldValue {
  id          String      @id @default(cuid())
  value       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  fieldId     String
  field       CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  entityId    String      // ID of the customer/deal/task/contact

  @@unique([fieldId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

// =============================================
// AI Chat Session Model - جلسات المحادثة مع AI
// =============================================
model ChatSession {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

// =============================================
// AI Chat Message Model - رسائل المحادثة
// =============================================
model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String   // "user" | "assistant" | "system"
  content     String
  actionType  String?  // e.g. "CREATE_CUSTOMER", "UPDATE_DEAL"
  actionData  Json?    // The action parameters
  actionResult Json?   // The result of the executed action
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// =============================================
// Subscription Model - الاشتراكات (Stripe)
// =============================================
model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                PlanTier           @default(FREE)
  status              SubscriptionStatus @default(TRIALING)
  stripeCustomerId    String?            @unique
  stripeSubscriptionId String?           @unique
  stripePriceId       String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  trialStart          DateTime?          @default(now())
  trialEnd            DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  canceledAt          DateTime?
  // Usage tracking
  customersUsed       Int                @default(0)
  dealsUsed           Int                @default(0)
  usersUsed           Int                @default(1)
  storageUsedMB       Int                @default(0)
  aiRequestsUsed      Int                @default(0)
  aiRequestsResetAt   DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([stripeCustomerId])
  @@index([status])
  @@index([plan])
  @@index([trialEnd])
  @@map("subscriptions")
}

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

// =============================================
// Push Token Model - توكنات الإشعارات (Mobile)
// =============================================
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "ios" | "android" | "web"
  deviceName String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("push_tokens")
}

// =============================================
// Push Notification Log - سجل الاشعارات المرسلة
// =============================================
model PushNotificationLog {
  id        String   @id @default(cuid())
  title     String
  body      String
  data      Json?
  target    String   // "all" | "plan:STARTER" | "user:userId" | "platform:ios"
  sentBy    String   // admin userId
  sentCount Int      @default(0)
  failCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sentBy])
  @@index([createdAt])
  @@map("push_notification_logs")
}

// =============================================
// Refresh Token Model - توكنات التحديث
// =============================================
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

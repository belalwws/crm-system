# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Neon)
DATABASE_URL="postgresql://your_user:your_password@your-host.neon.tech/your_database?sslmode=require"

# JWT Secret (Change this to a random secure string, min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# NVIDIA NIM API Key (for AI features)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Clerk Authentication (Optional - for Clerk-based auth)
# CLERK_SECRET_KEY=your_clerk_secret_key
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-production-url.com

# Redis (Optional - falls back to in-memory cache)
# REDIS_URL=redis://localhost:6379

# Resend Email (Optional)
# RESEND_API_KEY=your_resend_api_key

# CSRF Secret (Optional - falls back to JWT_SECRET)
# CSRF_SECRET=your_csrf_secret_here

# Frontend URL (for CORS — comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

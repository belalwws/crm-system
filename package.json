{
  "name": "crm-system",
  "version": "1.0.0",
  "description": "Full-stack CRM application with Next.js, TypeScript, Node.js, and PostgreSQL (Prisma)",
  "author": "Belal WS",
  "license": "MIT",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start"
  },
  "keywords": [
    "crm",
    "react",
    "typescript",
    "nodejs",
    "express",
    "postgresql",
    "prisma",
    "full-stack",
    "clerk",
    "tailwindcss"
  ],
  "dependencies": {
    "expo": "^55.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  }
}
